{
  "appId": "stream.wavi.studio.qa",
  "productName": "Wavi Studio Staging",
  "copyright": "Copyright \u00a9 2026 Wavi",
  "extraMetadata": {
    "waviQaDefaults": {
      "apiBase": "https://wavi-staging-kvbq16xd5-rgdevas-projects.vercel.app/api",
      "publicUrl": "https://wavi-staging-kvbq16xd5-rgdevas-projects.vercel.app"
    }
  },
  "directories": {
    "output": "release-staging"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*"
  ],
  "asarUnpack": [
    "node_modules/better-sqlite3/**/*",
    "node_modules/fsevents/**/*"
  ],
  "protocols": [
    {
      "name": "wavi-qa-protocol",
      "schemes": [
        "wavi-qa"
      ]
    }
  ],
  "mac": {
    "category": "public.app-category.music",
    "icon": "public/icon.icns",
    "hardenedRuntime": true,
    "gatekeeperAssess": true,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "target": [
      {
        "target": "dir",
        "arch": [
          "arm64"
        ]
      }
    ]
  },
  "dmg": {
    "sign": false
  }
}
