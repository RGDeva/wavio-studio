{
  "name": "wavio-studio",
  "version": "1.1.0",
  "description": "Wavi Studio — Desktop DAW sync agent",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.electron.json; concurrently \"vite\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on tcp:5173 dist-electron/main.js && electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "build:all": "npm run build && electron-builder",
    "build:mac": "npm run build && electron-builder --mac",
    "build:mac:qa": "node scripts/build-qa.mjs",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "lint": "eslint . --ext ts,tsx",
    "test:setup-native": "node scripts/check-test-node.mjs && npm --prefix electron/test-native ci",
    "pretest": "node scripts/check-test-node.mjs",
    "test": "vitest run",
    "postinstall": "electron-rebuild -f -w better-sqlite3 || true",
    "build:mac:staging": "node scripts/build-staging.mjs"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.2.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@sentry/electron": "^7.10.0",
    "@tonejs/midi": "^2.0.28",
    "better-sqlite3": "^11.9.1",
    "chokidar": "^3.6.0",
    "clsx": "^2.1.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "form-data": "^4.0.0",
    "framer-motion": "^11.3.19",
    "lucide-react": "^0.344.0",
    "p-queue": "^8.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "tus-js-client": "^4.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.20",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "vite": "^5.4.2",
    "vite-plugin-electron": "^0.28.7",
    "vitest": "^1.6.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.wavi.studio",
    "productName": "Wavi Studio",
    "copyright": "Copyright © 2026 Wavi",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/fsevents/**/*"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://wavi.stream/releases"
      }
    ],
    "protocols": [
      {
        "name": "wavi-protocol",
        "schemes": ["wavi"]
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "public/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "icon": "public/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "public/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
